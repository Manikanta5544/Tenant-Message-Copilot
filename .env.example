# ---- Server-side secrets. Never commit .env. ----

# Database. Migrations and seed use the DIRECT owner connection; the app uses the POOLED restricted role.
DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/copilot
DATABASE_URL_APP=postgres://copilot_app:app@localhost:5432/copilot
# Password given to the restricted role copilot_app by `npm run migrate` (use it in DATABASE_URL_APP).
APP_ROLE_PASSWORD=app

# Tests (a separate database; it is dropped and rebuilt on every run).
TEST_DATABASE_URL_OWNER=postgres://postgres:postgres@localhost:5432/copilot_test
TEST_DATABASE_URL_APP=postgres://copilot_app:app@localhost:5432/copilot_test

# ---- The model: THE SPACE LEFT FOR YOUR KEY ----
# live = call the model; replay = serve recorded real responses; mock = deterministic stand-in (labelled "Mock").
PROVIDER_MODE=live                # production REFUSES to start in mock (decision D1). For local development without a key, set PROVIDER_MODE=mock explicitly.
# Any OpenAI-compatible endpoint. Groq free tier shown; get a key at https://console.groq.com
LLM_PROVIDER=openai_compat
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# IDs per Groq's deprecations page (the Llama 3.x IDs were shut down 16 Aug 2026). Confirm yours with `npm run models`.
LLM_MODEL_TRIAGE=openai/gpt-oss-20b
LLM_MODEL_DRAFT=openai/gpt-oss-120b
LLM_MODEL_CHECK=openai/gpt-oss-20b
# Reasoning models spend hidden tokens against max_tokens: keep effort low and add headroom.
LLM_REASONING_EFFORT=low
LLM_OUTPUT_HEADROOM=1000
# Optional: set false if your endpoint rejects response_format=json_object.
# LLM_JSON_MODE=true
# Optional micro-USD per million tokens by model; omit for free tiers (cost then reads as zero).
# Reasoning effort for the short triage and semantic-check calls only (the draft uses LLM_REASONING_EFFORT). Keep only if evals are unchanged.
# LLM_REASONING_EFFORT_FAST=low
# Model calls in flight per server instance, and how long one may wait for a slot before the visible "busy" fallback.
# LLM_MAX_CONCURRENCY=4
# LLM_QUEUE_WAIT_MS=8000
# Live-stream (SSE) caps: per client IP and per server instance. Over the cap the page polls instead.
# SSE_MAX_PER_IP=4
# SSE_MAX_GLOBAL=200
# Prices default to ASSUMED list prices for the two default Groq models (see core/prices.ts). Override with your own:
# LLM_PRICES_JSON={"openai/gpt-oss-120b":{"in":150000,"out":600000}}
# To use Anthropic instead: LLM_PROVIDER=anthropic and set ANTHROPIC_API_KEY.
# ANTHROPIC_API_KEY=

# ---- Demo behaviour ----
DEMO_AS_OF_DATE=2026-11-19        # the "today" every scenario is computed against
DEMO_DAILY_BUDGET_USD=2           # atomic daily cap (only binds when prices are configured)
RATE_LIMIT_PER_HOUR=20            # runs per visitor (IP hash) per hour
RATE_LIMIT_PER_DAY=40             # runs per visitor per rolling 24 h (one visitor cannot use up the shared daily cap)
MESSAGE_LIMIT_PER_HOUR=10         # custom messages per visitor per hour
DEMO_MAX_RUNS_PER_DAY=150         # hard daily run cap (UTC day); protects free-tier quota
EVAL_PACE_MS=2000                 # pause between live eval cases (free-tier rate limits)
VISITOR_SALT=                     # REQUIRED in production: at least 32 random characters (`openssl rand -hex 32`); /api/ready fails otherwise
# Trust x-forwarded-for for rate limits only behind a proxy you control. Vercel sets VERCEL=1 itself; elsewhere set TRUST_PROXY=1.
# TRUST_PROXY=0
# TRUSTED_PROXY_HOPS=1                 # proxies in front of the app; the client is the Nth address from the right of x-forwarded-for
# RATE_LIMIT_PER_IP_PER_HOUR=60       # per network, independent of the cookie (needs a trusted proxy)
# RATE_LIMIT_PER_IP_PER_DAY=120
# Trusted proxies in front of the app: the client address is the Nth entry from the right of x-forwarded-for.
# TRUSTED_PROXY_HOPS=1
# Add `preload` to HSTS (only if you will submit the domain to the preload list).
# HSTS_PRELOAD=0
# Optional: GitHub repo URL; the evals page links the recorded commit to it.
# REPO_URL=https://github.com/you/tenant-copilot

# Database connections per server instance (default 10; idle ones close after 10 s).
# DB_POOL_MAX=10
